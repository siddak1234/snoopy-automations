{
  "name": "snoopy-automations",
  "version": "0.1.0",
  "private": true,
  "description": "Autom8x automations \u2014 automation logic that calls the platform API; holds no secrets, receives only run-scoped tokens at runtime.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "automations/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "tsx --test \"test/**/*.test.ts\" && npm test --workspaces --if-present",
    "verify": "npm run format:check && npm run build && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
