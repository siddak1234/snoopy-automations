{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.autom8x.dev/schemas/automation-manifest.json",
  "title": "AutomationManifest",
  "type": "object",
  "properties": {
    "templateId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$",
      "maxLength": 64
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "category",
        "icon"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monthlyPriceUsd"
      ],
      "properties": {
        "monthlyPriceUsd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "schedule",
            "webhook",
            "manual",
            "provider-event"
          ]
        },
        "everySeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 31622400
        },
        "connection": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$",
          "maxLength": 64
        }
      }
    },
    "requiredConnections": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "providerId",
          "displayName",
          "purpose",
          "scopes"
        ],
        "properties": {
          "providerId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$",
            "maxLength": 64
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "scopes": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "enum": [
          "document-extraction",
          "classification",
          "screening",
          "summarization"
        ]
      }
    },
    "setup": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section",
          "key",
          "title",
          "description",
          "control",
          "required"
        ],
        "properties": {
          "section": {
            "enum": [
              "connections",
              "source",
              "rules",
              "notifications"
            ]
          },
          "key": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$",
            "maxLength": 64
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "control": {
            "enum": [
              "toggle",
              "money",
              "text",
              "resource-picker"
            ]
          },
          "defaultValue": {},
          "required": {
            "type": "boolean"
          },
          "notifies": {
            "enum": [
              "approval-requested",
              "approval-expiring",
              "run-failed"
            ]
          }
        }
      }
    },
    "pipeline": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kicker",
          "title",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$",
            "maxLength": 64
          },
          "kicker": {
            "enum": [
              "TRIGGER",
              "AI STEP",
              "ACTION"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "serviceAccount",
        "contractVersion",
        "maxConcurrentRuns",
        "acceptTimeoutMs",
        "runTimeoutSeconds"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/?#@]+$"
        },
        "serviceAccount": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{4,29}@[a-z][a-z0-9-]{4,29}\\.iam\\.gserviceaccount\\.com$"
        },
        "contractVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxConcurrentRuns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "acceptTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000
        },
        "runTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "outputSchema": {
      "type": "object"
    }
  },
  "required": [
    "templateId",
    "version",
    "display",
    "pricing",
    "trigger",
    "requiredConnections",
    "requiredCapabilities",
    "setup",
    "pipeline",
    "service",
    "outputSchema"
  ],
  "additionalProperties": false
}
