{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.autom8x.dev/schemas/automation-manifest.json",
  "title": "AutomationManifest",
  "type": "object",
  "properties": {
    "templateId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$",
      "maxLength": 64
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "category",
        "icon"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "category": {
          "enum": [
            "HR",
            "Accounting",
            "Finance",
            "Legal",
            "Compliance",
            "Data",
            "Operations",
            "Sales",
            "Marketing",
            "Customer Support",
            "IT",
            "Engineering",
            "Product",
            "Procurement",
            "Administration",
            "Research"
          ]
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "documentWords": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "singular",
            "plural"
          ],
          "properties": {
            "singular": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "plural": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          }
        },
        "pages": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "flow": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "dashboard",
                  "steps",
                  "items"
                ]
              }
            },
            "item": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "tiles",
                  "file",
                  "add",
                  "runs",
                  "scores"
                ]
              }
            },
            "run": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "files",
                  "outcome",
                  "result"
                ]
              }
            },
            "file": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "viewer",
                  "reading"
                ]
              }
            }
          }
        }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monthlyPriceUsd"
      ],
      "properties": {
        "monthlyPriceUsd": {
          "type": "number",
          "minimum": 0,
          "multipleOf": 0.01
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "schedule",
            "webhook",
            "manual",
            "provider-event"
          ]
        },
        "everySeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 31622400
        },
        "connection": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$",
          "maxLength": 64
        },
        "input": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "title",
              "description",
              "control",
              "required"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]*$",
                "maxLength": 64
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "control": {
                "enum": [
                  "toggle",
                  "money",
                  "text",
                  "email",
                  "artifact"
                ]
              },
              "defaultValue": {},
              "required": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "requiredConnections": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "providerId",
          "displayName",
          "purpose",
          "scopes"
        ],
        "properties": {
          "providerId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$",
            "maxLength": 64
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "scopes": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "optional": {
            "type": "boolean"
          }
        }
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "document-extraction",
          "classification",
          "screening",
          "summarization"
        ]
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptedContentTypes",
        "maximumSizeBytes"
      ],
      "properties": {
        "acceptedContentTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*\\/(\\*|[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*)$"
          }
        },
        "maximumSizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 104857600
        },
        "maximumPdfPages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maximumImageSidePixels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        }
      }
    },
    "setup": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section",
          "key",
          "title",
          "description",
          "control",
          "required"
        ],
        "properties": {
          "section": {
            "enum": [
              "connections",
              "source",
              "rules",
              "notifications"
            ]
          },
          "key": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$",
            "maxLength": 64
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "control": {
            "enum": [
              "toggle",
              "money",
              "text",
              "email",
              "resource-picker",
              "connection",
              "select"
            ]
          },
          "defaultValue": {},
          "required": {
            "type": "boolean"
          },
          "notifies": {
            "enum": [
              "approval-requested",
              "approval-expiring",
              "run-failed",
              "run-succeeded"
            ]
          },
          "providers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$",
              "maxLength": 64
            }
          },
          "group": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$",
            "maxLength": 64
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "multiple": {
            "type": "boolean"
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$",
            "maxLength": 64
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "titleByConnection": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "titles"
            ],
            "properties": {
              "field": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$",
                "maxLength": 64
              },
              "titles": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "providerId",
                    "title"
                  ],
                  "properties": {
                    "providerId": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$",
                      "maxLength": 64
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    }
                  }
                }
              }
            }
          },
          "platform": {
            "enum": [
              "email"
            ]
          }
        }
      }
    },
    "pipeline": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kicker",
          "title",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$",
            "maxLength": 64
          },
          "kicker": {
            "enum": [
              "TRIGGER",
              "AI STEP",
              "ACTION"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "group": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$",
            "maxLength": 64
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "serviceAccount",
        "contractVersion",
        "maxConcurrentRuns",
        "acceptTimeoutMs",
        "runTimeoutSeconds"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "format": "uri",
          "pattern": "^(https://(\\[[0-9a-f:.]+\\]|[a-z0-9._-]+)|http://(localhost|127\\.0\\.0\\.1|\\[::1\\]|[a-z0-9._-]+\\.(internal|localhost)))(:(0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?/?$"
        },
        "serviceAccount": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{4,29}@[a-z][a-z0-9-]{4,29}\\.iam\\.gserviceaccount\\.com$"
        },
        "contractVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxConcurrentRuns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "acceptTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000
        },
        "runTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "outputSchema": {
      "type": "object"
    },
    "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "words",
        "runWords",
        "titleField",
        "fields",
        "file",
        "pipeline",
        "outputSchema"
      ],
      "properties": {
        "words": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "singular",
            "plural"
          ],
          "properties": {
            "singular": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "plural": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          }
        },
        "runWords": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "singular",
            "plural"
          ],
          "properties": {
            "singular": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "plural": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          }
        },
        "titleField": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$",
          "maxLength": 64
        },
        "groupField": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$",
          "maxLength": 64
        },
        "verdictWords": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "positive",
            "negative"
          ],
          "properties": {
            "positive": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "negative": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          }
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "title",
              "control",
              "required"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]*$",
                "maxLength": 64
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "control": {
                "enum": [
                  "text",
                  "select"
                ]
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              },
              "allowOther": {
                "type": "boolean"
              },
              "defaultValue": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "required": {
                "type": "boolean"
              },
              "maxLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 200
              }
            }
          }
        },
        "file": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "title",
            "description"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9]*$",
              "maxLength": 64
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "pipeline": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$",
                "maxLength": 64
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "object"
            }
          }
        }
      }
    }
  },
  "required": [
    "templateId",
    "version",
    "display",
    "pricing",
    "trigger",
    "requiredConnections",
    "requiredCapabilities",
    "setup",
    "pipeline",
    "service",
    "outputSchema"
  ],
  "additionalProperties": false
}
