{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.autom8x.dev/schemas/automation-step-report.json",
  "title": "AutomationStepReport",
  "type": "object",
  "properties": {
    "stepId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$",
      "maxLength": 64
    },
    "outcome": {
      "enum": [
        "ok",
        "held",
        "failed"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "heldReason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "stepId",
    "outcome",
    "summary"
  ],
  "additionalProperties": false
}
