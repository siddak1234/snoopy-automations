{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.autom8x.dev/schemas/automation-model-request.json",
  "title": "AutomationModelRequest",
  "type": "object",
  "properties": {
    "capability": {
      "enum": [
        "document-extraction",
        "classification",
        "screening",
        "summarization"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object"
    },
    "outputSchema": {
      "type": "object"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^(?!~?openrouter\\/)(?!.*:online(?::|$))(?!.*:(?:nitro|floor)(?::|$))[a-z0-9._:/~-]{1,128}$"
      }
    }
  },
  "required": [
    "capability",
    "prompt",
    "input",
    "outputSchema"
  ],
  "additionalProperties": false
}
