{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.autom8x.dev/schemas/automation-provider-request.json",
  "title": "AutomationProviderRequest",
  "type": "object",
  "properties": {
    "providerId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$",
      "maxLength": 64
    },
    "operation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "input": {
      "type": "object"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    }
  },
  "required": [
    "providerId",
    "operation",
    "input",
    "idempotencyKey"
  ],
  "additionalProperties": false
}
