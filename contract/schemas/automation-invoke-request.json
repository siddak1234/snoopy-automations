{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.autom8x.dev/schemas/automation-invoke-request.json",
  "title": "AutomationInvokeRequest",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string"
    },
    "templateId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$",
      "maxLength": 64
    },
    "templateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "workspaceId": {
      "type": "string"
    },
    "config": {
      "type": "object"
    },
    "input": {
      "type": "object"
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ofRunId",
        "kind",
        "state"
      ],
      "properties": {
        "ofRunId": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "approval"
          ]
        },
        "stepId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$",
          "maxLength": 64
        },
        "decision": {
          "enum": [
            "approved",
            "rejected"
          ]
        },
        "decidedAt": {
          "type": "string",
          "format": "date-time"
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 400,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "decision"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$",
                "maxLength": 64
              },
              "decision": {
                "enum": [
                  "accepted",
                  "denied"
                ]
              }
            }
          }
        },
        "state": {
          "type": "object"
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fields",
        "reading"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "reading": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "readsItem": {
      "const": true
    },
    "batch": {
      "const": true
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parentRunId",
        "index",
        "label",
        "artifacts",
        "data"
      ],
      "properties": {
        "parentRunId": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 499
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifactId"
            ],
            "properties": {
              "artifactId": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
              },
              "pages": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "to"
                ],
                "properties": {
                  "from": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "to": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "data": {
          "type": "object"
        }
      }
    },
    "callbackOrigin": {
      "type": "string",
      "format": "uri"
    },
    "runToken": {
      "type": "string",
      "minLength": 1
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "runId",
    "templateId",
    "templateVersion",
    "workspaceId",
    "config",
    "input",
    "callbackOrigin",
    "runToken",
    "deadline"
  ],
  "additionalProperties": false
}
